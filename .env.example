# ZekaHub — ortam degiskenleri (ornek)
# Gercek degerler Vercel proje ayarlarinda tutulur, bu dosyaya YAZILMAZ.

# --- Admin girisi ---
# Eskiden kullanici adi/sifre koda gomuluydu ve oturum cerezi sabit bir
# metindi (taklit edilebiliyordu). Artik ikisi de buradan geliyor ve cerez
# ADMIN_OTURUM_SIRRI ile HMAC imzalaniyor.
ADMIN_KULLANICI=
ADMIN_SIFRE=
ADMIN_OTURUM_SIRRI=

# --- WhatsApp / Evolution API ---
# Hetzner sunucusundaki Evolution API. Anahtar yalnizca kendi instance'imiza
# erisir (global yonetici anahtari degildir).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Evolution'in webhook cagrisini dogrulamak icin gizli jeton.
# Webhook adresi: https://<site>/api/whatsapp/webhook?jeton=<bu deger>
WHATSAPP_WEBHOOK_JETONU=

# --- Supabase (WhatsApp ayar/kural deposu) ---
# Vercel'de dosya sistemi kalici olmadigi icin ayarlar ve kurallar burada.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
